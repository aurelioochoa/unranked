# --- the hunter -------------------------------------------------------------
HUNTER_ID=solo
HUNTER_NAME=Aurelio
HUNTER_TIMEZONE=Europe/Madrid
DAILY_RESET_HOUR=4

# --- storage ----------------------------------------------------------------
DATABASE_PATH=./data/unranked.db

# --- the System's voice (text) ----------------------------------------------
# none | webllm | anthropic | openai | google | ollama | openai-compatible
# `none` is fully supported: the System speaks from its own authored script.
#
# `webllm` runs the model in your browser on WebGPU — no server, no key, and
# nothing leaves the machine. It needs a one-time model download (a few hundred
# MB to a few GB), which the app asks for rather than starting on its own.
# Everything here can also be set from Settings, which wins over these values.
# The API key is the exception: it is only ever read from AI_API_KEY.
AI_PROVIDER=none
# AI_MODEL=claude-sonnet-5
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MAX_OUTPUT_TOKENS=400

# --- thinking models --------------------------------------------------------
# Thinking models write better System lines and are much slower. On by default.
#
# Measured on a local qwen3.5:4b asked for one System line:
#   AI_THINKING=off   ~5s,  a good line
#   AI_THINKING=on    ~35s, a better line
# and a thinking attempt given too small a budget returns NOTHING, having spent
# it all reasoning — which is why the reasoning budget and the cap below exist.
# If a thinking attempt overruns the cap, the System retries without thinking
# and, failing that, speaks its own authored line. It always says something.
# AI_THINKING=on
# AI_REASONING_TOKENS=3000
# AI_THINKING_TIMEOUT_MS=60000

# Great Sage is configured separately in its panel. Default: Ollama qwen3.5:4b,
# thinking off. Speech runs locally in browser workers after explicit downloads.
# Cloud conversation is optional and must be selected explicitly in Sage settings.
# Provider-specific keys take precedence over the compatible AI_API_KEY fallback.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Disable telemetry in any external Cactus Python tooling as well.
NEEDLE_TELEMETRY=0
DO_NOT_TRACK=1
